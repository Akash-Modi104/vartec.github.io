DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=vartec.global,www.vartec.global
DJANGO_CSRF_TRUSTED_ORIGINS=https://vartec.global,https://www.vartec.global
DATABASE_URL=postgresql://user:password@host:5432/database
DJANGO_MEDIA_ROOT=/var/data/media
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=website@vartec.global
